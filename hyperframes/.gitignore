tools/__pycache__/
# Shorts: shared files copied in by sync; images, story.js and check.json are kept
shorts/*/assets/lib/
shorts/*/assets/fonts/
shorts/*/assets/css/
shorts/*/assets/geo/
shorts/um-parisiman/assets/geo3d.js
shorts/*/.hyperframes/
shorts/*/assets/atlas/
# language versions: page and images are copied from the base Short by shorts_build.py story
shorts/*-hi/index.html
shorts/*-hi/assets/
