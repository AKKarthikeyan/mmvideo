#!/usr/bin/env python3
# HyperFrames renders on the Mini: PATH=hyperframes/tools/ffwrap:$PATH python3 hyperframes/tools/hf.py render <id>
# Remotion's ffmpeg has no `setparams` filter: drop it from any filter chain and set the same colour tags as output options.
import os, re, sys
real = "/Volumes/DarwinSSD/DataKadai/mmvideo-dk/node_modules/@remotion/compositor-darwin-arm64/ffmpeg"
os.environ["DYLD_LIBRARY_PATH"] = os.path.dirname(real)
a, tags = sys.argv[1:], []

for i, x in enumerate(a):
    if i and a[i - 1] in ("-vf", "-filter:v", "-filter_complex") and "setparams" in x:
        for m in re.finditer(r"setparams=([^,;\]]+)", x):
            for kv in m.group(1).split(":"):
                k, _, v = kv.partition("=")
                k = {"range": "color_range", "colorspace": "colorspace"}.get(k, k)
                tags += [f"-{k}", v]
        x = re.sub(r",?setparams=[^,;\]]+", "", x).strip(",")
        a[i] = x or "null"
if tags and len(a) > 1:
    a = a[:-1] + tags + a[-1:]
os.execv(real, [real] + a)
