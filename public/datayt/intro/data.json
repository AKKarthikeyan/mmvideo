 "vo": [
  {
   "file": "vo_00.mp3",
   "at": 0.12,
   "sec": 3.369,
   "text": "One state grows nearly half of India's sugarcane."
  },
  {
   "file": "vo_01.mp3",
   "at": 3.689,
   "sec": 1.436,
   "text": "Uttar Pradesh."
  },
  {
   "file": "vo_02.mp3",
   "at": 5.926,
   "sec": 5.25,
   "text": "Bihar: lowest income per person, yet 5G in ninety-six of a hundred villages."
  },
  {
   "file": "vo_03.mp3",
   "at": 11.733,
   "sec": 3.056,
   "text": "India's official tables are full of numbers like these."
  },
  {
   "file": "vo_04.mp3",
   "at": 14.989,
   "sec": 1.567,
   "text": "You just have to open them."
  },
  {
   "file": "vo_05.mp3",
   "at": 17.055,
   "sec": 1.071,
   "text": "We do."
  },
  {
   "file": "vo_06.wav",
   "at": 18.326,
   "sec": 0.939,
   "text": "Data Kadai."
  },
  {
   "file": "vo_07.mp3",
   "at": 19.465,
   "sec": 1.436,
   "text": "It means data shop."
  },
  {
   "file": "vo_08.mp3",
   "at": 21.101,
   "sec": 2.847,
   "text": "This one serves India's numbers, fresh."
  },
  {
   "file": "vo_09.mp3",
   "at": 24.797,
   "sec": 4.623,
   "text": "A new number every day, from official sources, named on screen."
  },
  {
   "file": "vo_10.mp3",
   "at": 30.12,
   "sec": 4.728,
   "text": "Money, farms, schools, and how your state compares."
  },
  {
   "file": "vo_11.mp3",
   "at": 35.443,
   "sec": 2.925,
   "text": "So, where does your state rank?"
  }
 ],
