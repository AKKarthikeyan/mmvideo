 "lines": [
  {
   "key": "r1",
   "who": "raghavan",
   "voice": "ratan",
   "text": "Coffee for the night pharmacist! Fresh filter. Strong, like me.",
   "italic": false,
   "start": 4.95,
   "dur": 4.292
  },
  {
   "key": "m1",
   "who": "meena",
   "voice": "kavitha",
   "text": "Good evening, Raghu! Nobody is strong at one o'clock in the morning.",
   "italic": false,
   "start": 9.592,
   "dur": 4.075
  },
  {
   "key": "b1",
   "who": "babu",
   "voice": "rohan",
   "text": "Day one. One-oh-seven a.m. Raghu uncle arrives. Every night. Like a clock.",
   "italic": true,
   "start": 16.717,
   "dur": 4.929
  },
  {
   "key": "r2",
   "who": "raghavan",
   "voice": "ratan",
   "text": "Tomorrow's order, madam. Sign here, and I will leave you in peace.",
   "italic": false,
   "start": 21.996,
   "dur": 3.602
  },
  {
   "key": "b2",
   "who": "babu",
   "voice": "rohan",
   "text": "Akka, your glasses. They are on your head.",
   "italic": false,
   "start": 26.798,
   "dur": 2.906
  },
  {
   "key": "m2",
   "who": "meena",
   "voice": "kavitha",
   "text": "For thirty years I have signed my name, Babu. My hand knows the way.",
   "italic": false,
   "start": 29.954,
   "dur": 5.79
  },
  {
   "key": "r3",
   "who": "raghavan",
   "voice": "ratan",
   "text": "Your copy, madam.",
   "italic": false,
   "start": 36.794,
   "dur": 0.836
  },
  {
   "key": "b3",
   "who": "babu",
   "voice": "rohan",
   "text": "Uncle, what's your medicine? Akka knows everyone's medicine.",
   "italic": false,
   "start": 38.08,
   "dur": 3.482
  },
  {
   "key": "m3",
   "who": "meena",
   "voice": "kavitha",
   "text": "Him? Nothing at all. Strong as an ox.",
   "italic": false,
   "start": 41.812,
   "dur": 3.244
  },
  {
   "key": "r4",
   "who": "raghavan",
   "voice": "ratan",
   "text": "Never taken a pill in my life!",
   "italic": false,
   "start": 45.356,
   "dur": 1.495
  },
  {
   "key": "r5",
   "who": "raghavan",
   "voice": "ratan",
   "text": "Good night, Meena. Going home. Anna Nagar.",
   "italic": false,
   "start": 50.651,
   "dur": 2.495
  }
 ],
