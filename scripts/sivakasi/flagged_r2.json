"hi": {
"यह उस दौर के मिज़ाज से मेल खाता है। महात्मा गांधी भारतीयों से ग्राम उद्योग फिर से जगाने को कह रहे हैं।": {
"slot": 5.55,
"len": 6.69,
"need": 1.03,
"speed": 1.21
},
"हर माचिस और हर पटाखे के पैकेट को चमकीला काग़ज़ी लेबल चाहिए। उन्नीस सौ तीस के दशक में ये लेबल बंबई, यानी आज के मुंबई, के प्रेसों से आते थे।": {
"slot": 8.95,
"len": 11.61,
"need": 0.95,
"speed": 1.3
},
"अब वह मोड़ आता है जो एक अच्छे शहर को राष्ट्रीय शहर बना देता है। उन्नीस सौ चालीस।": {
"slot": 5.1,
"len": 6.13,
"need": 1.03,
"speed": 1.2
},
"उन्नीस सौ बयालीस में तीन लाइसेंस वाली फ़ैक्ट्रियाँ।": {
"slot": 3.03,
"len": 3.93,
"need": 0.95,
"speed": 1.3
},
"लेकिन साधारण लकड़ी की तीली अलग नहीं दिखती। और दोनों प्रतिद्वंद्वी अलग दिखना चाहते हैं।": {
"slot": 4.97,
"len": 6.01,
"need": 1.02,
"speed": 1.21
}
